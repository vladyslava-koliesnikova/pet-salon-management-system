<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.ics.LoginController">
   <top>
      <Label alignment="TOP_CENTER" contentDisplay="CENTER" text="WELCOME" textAlignment="CENTER" textFill="#9de8ed" BorderPane.alignment="CENTER">
         <font>
            <Font name="Bodoni MT Black" size="36.0" />
         </font>
         <BorderPane.margin>
            <Insets top="30.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <bottom>
      <ToolBar style="-fx-background-color: #aae2e6;" BorderPane.alignment="CENTER">
         <items>
            <Label text="Don't have an account?" />
            <Button fx:id="signupButton" mnemonicParsing="false" onAction="#signupButtonAction" text="Sign up here" />
         </items>
      </ToolBar>
   </bottom>
   <center>
      <VBox alignment="CENTER" spacing="20.0">
         <children>
            <Label text="Email Address">
               <font>
                  <Font size="13.0" />
               </font></Label>
            <TextField fx:id="emailTextField" promptText="Enter email" style="-fx-border-color: #32e6fa;">
               <VBox.margin>
                  <Insets left="100.0" right="100.0" />
               </VBox.margin></TextField>
            <Label text="Password">
               <font>
                  <Font size="13.0" />
               </font></Label>
            <PasswordField fx:id="passwordTextField" promptText="Enter password" style="-fx-border-color: #32e6fa;">
               <VBox.margin>
                  <Insets left="100.0" right="100.0" />
               </VBox.margin></PasswordField>
            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#loginButtonAction" style="-fx-font-size: 18;" text="Log in" />
         </children>
      </VBox>
   </center>
</BorderPane>
