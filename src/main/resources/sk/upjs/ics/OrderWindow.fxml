         <VBox.margin>
            <Insets left="30.0" right="30.0" />
         </VBox.margin>
      </ListView>
      <Button fx:id="closeButton" mnemonicParsing="false" onAction="#closeButtonAction" prefHeight="40.0" prefWidth="120.0" text="Close">
         <font>
            <Font size="18.0" />
