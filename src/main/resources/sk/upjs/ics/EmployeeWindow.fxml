               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="pastBookingsButton" mnemonicParsing="false" onAction="#pastBookingsButtonAction" text="Past bookings">
               <font>
                  <Font size="14.0" />
               </font>
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="allOrdersButton" mnemonicParsing="false" onAction="#allOrdersButtonAction" text="All orders">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
         <VBox.margin>
            <Insets left="30.0" right="30.0" />
         </VBox.margin>
      </HBox>
      <HBox alignment="CENTER" prefHeight="57.0" prefWidth="398.0" style="-fx-border-color: #32e6fa; -fx-border-width: 3; -fx-background-color: #c5eef0;" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="removeSelectedButton" mnemonicParsing="false" onAction="#removeButtonAction" text="Remove selected">
               <font>
                  <Font size="14.0" />
               </font>
               <HBox.margin>
