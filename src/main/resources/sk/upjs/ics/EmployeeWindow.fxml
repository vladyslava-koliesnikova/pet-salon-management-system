<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.ics.EmployeeWindowController">
   <children>
      <HBox alignment="TOP_RIGHT" prefHeight="48.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="addEmployeeButton" mnemonicParsing="false" onAction="#addEmployeeButtonAction" text="Add employee">
               <font>
                  <Font size="14.0" />
               </font>
               <HBox.margin>
                  <Insets right="5.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="48.0" prefWidth="600.0" style="-fx-border-color: #32e6fa; -fx-border-width: 3; -fx-background-color: #c5eef0;" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="clientsButton" mnemonicParsing="false" onAction="#clientsButtonAction" text="Clients">
               <font>
                  <Font size="14.0" />
               </font>
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="upcomingBookingsButton" mnemonicParsing="false" onAction="#upcomingBookingsButtonAction" text="Upcoming bookings">
               <font>
                  <Font size="14.0" />
