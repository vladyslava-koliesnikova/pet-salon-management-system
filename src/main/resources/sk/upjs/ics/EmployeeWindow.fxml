                  <Font size="14.0" />
               </font>
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="showEmployeesButton" mnemonicParsing="false"
                    onAction="#showEmployeesButtonAction" text="Show employees">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
         <VBox.margin>
            <Insets bottom="5.0" left="30.0" right="30.0" />
         </VBox.margin>
      </HBox>
      <ListView fx:id="orderListView" prefHeight="199.0" prefWidth="549.0" style="-fx-border-color: #32e6fa; -fx-border-width: 3; -fx-background-color: #c5eef0;">
         <VBox.margin>
            <Insets left="30.0" right="30.0" />
         </VBox.margin>
      </ListView>
      <HBox alignment="BOTTOM_RIGHT" prefHeight="45.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="signOffButton" mnemonicParsing="false" onAction="#signOffButtonAction" text="Sign off" HBox.hgrow="ALWAYS">
